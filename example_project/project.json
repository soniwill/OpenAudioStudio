{
  "version": 1,
  "name": "ExampleGameProject",
  "buses": [
    { "path": "bus:/sfx", "volume": 1.0, "effects": [] },
    { "path": "bus:/music", "volume": 1.0, "effects": [] }
  ],
  "global_parameters": [
    {
      "name": "MasterVolume",
      "kind": "continuous",
      "min": 0.0,
      "max": 1.0,
      "default_value": 0.8
    }
  ],
  "vcas": [
    {
      "path": "vca:/game_audio",
      "buses": [ "bus:/sfx", "bus:/music" ],
      "events": [ "event:/music/theme", "event:/sfx/coin" ]
    }
  ],
  "samples": [
    { "id": "sample_coin", "file": "assets/coin.wav" },
    { "id": "sample_music", "file": "assets/theme.wav" },
    { "id": "sample_charge_up", "file": "assets/charge_up.wav" },
    { "id": "sample_charge_hold", "file": "assets/charge_hold.wav" },
    { "id": "sample_charge_release", "file": "assets/charge_release.wav" }
  ],
  "events": [
    {
      "path": "event:/music/theme",
      "kind": "event",
      "bus_path": "bus:/music",
      "volume_db": -2.0,
      "tracks": [
        {
          "volume_db": 0.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_music",
              "offset_ms": 0.0,
              "length_ms": 2000.0,
              "loop": true
            }
          ]
        }
      ]
    },
    {
      "path": "event:/sfx/coin",
      "kind": "event",
      "bus_path": "bus:/sfx",
      "volume_db": 0.0,
      "tracks": [
        {
          "volume_db": 0.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_coin",
              "offset_ms": 0.0,
              "length_ms": 300.0,
              "loop": false
            }
          ]
        }
      ]
    },
    {
      "path": "event:/sfx/charge_sustain",
      "kind": "event",
      "bus_path": "bus:/sfx",
      "volume_db": -2.0,
      "logic_items": [
        {
          "kind": "sustain_point",
          "position_ms": 600.0
        }
      ],
      "tracks": [
        {
          "volume_db": 0.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_charge_up",
              "offset_ms": 0.0,
              "length_ms": 600.0,
              "loop": false
            },
            {
              "kind": "single",
              "sample_id": "sample_charge_release",
              "offset_ms": 600.0,
              "length_ms": 700.0,
              "loop": false
            }
          ]
        }
      ]
    },
    {
      "path": "event:/sfx/charge_loop_hold",
      "kind": "event",
      "bus_path": "bus:/sfx",
      "volume_db": -2.0,
      "logic_items": [
        {
          "kind": "loop_region",
          "start_ms": 600.0,
          "length_ms": 1000.0,
          "iterations": -1,
          "until_key_off": true
        }
      ],
      "tracks": [
        {
          "volume_db": 0.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_charge_up",
              "offset_ms": 0.0,
              "length_ms": 600.0,
              "loop": false
            },
            {
              "kind": "single",
              "sample_id": "sample_charge_hold",
              "offset_ms": 600.0,
              "length_ms": 1000.0,
              "loop": true
            },
            {
              "kind": "single",
              "sample_id": "sample_charge_release",
              "offset_ms": 1600.0,
              "length_ms": 700.0,
              "loop": false
            }
          ]
        }
      ]
    },
    {
      "path": "event:/sfx/charge_sustain_async",
      "kind": "event",
      "bus_path": "bus:/sfx",
      "volume_db": -2.0,
      "logic_items": [
        {
          "kind": "sustain_point",
          "position_ms": 600.0
        }
      ],
      "tracks": [
        {
          "volume_db": 0.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_charge_up",
              "offset_ms": 0.0,
              "length_ms": 600.0,
              "loop": false
            },
            {
              "kind": "single",
              "sample_id": "sample_charge_release",
              "offset_ms": 600.0,
              "length_ms": 700.0,
              "loop": false
            }
          ]
        },
        {
          "volume_db": -3.0,
          "instruments": [
            {
              "kind": "single",
              "sample_id": "sample_charge_hold",
              "offset_ms": 550.0,
              "length_ms": 50.0,
              "async": true,
              "loop": true,
              "modulators": [
                {
                  "kind": "ahdsr",
                  "attack_ms": 80.0,
                  "hold_ms": 0.0,
                  "decay_ms": 0.0,
                  "sustain": 1.0,
                  "release_ms": 250.0,
                  "release_on_key_off": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "path": "snapshot:/pause_menu",
      "kind": "snapshot",
      "priority": 120,
      "snapshot_mode": "override",
      "fade_in_ms": 100.0,
      "snapshot_targets": [
        {
          "bus_path": "bus:/music",
          "value": -6.0,
          "param_id": -1,
          "position": 0,
          "effect_index": 0
        }
      ]
    }
  ],
  "effect_automations": [],
  "mixer": {
    "master": {
      "volume": 1.0,
      "mute": false
    }
  }
}
